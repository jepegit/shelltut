# Editor / OS
.DS_Store
*.swp
*~
.idea/
.vscode/
*.code-workspace

# Local scratch (keep directory, ignore contents)
playground/scratch/*
!playground/scratch/.gitkeep
*.tmp
*.bak

# Env / secrets
.env
.env.*

# Local DB dumps from drills (seed SQL in playground/postgres/init stays tracked)
playground/scratch/*.dump.sql
playground/scratch/*-export.csv

# Python / notebooks if you mix them in later
__pycache__/
.ipynb_checkpoints/
.venv/
venv/
